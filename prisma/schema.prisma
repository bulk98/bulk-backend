// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// --- ENUMS ---

enum UserType {
  OG
  CREW
}

enum RoleInCommunity {
  CREATOR
  MODERATOR
  MEMBER
}

enum ReactionType {
  LIKE
}

enum CommunitySubscriptionStatus {
  PENDING
  ACTIVE
  REJECTED
  CANCELED
  EXPIRED
}

enum ManualPaymentMethod {
  NEQUI
  BINANCE
  BANK_TRANSFER
  PAYPAL
  WHATSAPP
  EXTERNAL_LINK
  OTHER
}

enum NotificationType {
  NEW_COMMENT
  POST_LIKE
  NEW_SUBSCRIBER
  NEW_MEMBER
  PROMOTION_TO_MODERATOR
}

// --- MODELOS ---

model User {
  id                       String   @id @default(auto()) @map("_id") @db.ObjectId
  email                    String   @unique
  password                 String?
  createdAt                DateTime @default(now())
  googleId                 String?

  tipo_usuario             UserType

  name                     String?
  username                 String?  @unique
  bio                      String?
  fechaDeNacimiento        DateTime?
  paisDeNacimiento         String?
  ciudadDeNacimiento       String?
  domicilio                String?
  celular                  String?

  avatarUrl                String?
  avatarPublicId           String?

  passwordResetToken       String?
  passwordResetExpires     DateTime?

  isVerified               Boolean? @default(false)
  emailVerificationToken   String?

  createdCommunities       Community[] @relation("CreatedCommunities")
  memberships              CommunityMembership[]
  suscritoAComunidadesIds  String[] @db.ObjectId

  posts                    Post[] @relation("PostAuthor")
  comments                 Comment[] @relation("CommentAuthor")
  reactions                Reaction[]

  notificationsAsRecipient Notification[] @relation("Recipient")
  notificationsAsActor     Notification[] @relation("Actor")

  communitySubscriptions         CommunitySubscription[] @relation("UserCommunitySubscriptions")
  reviewedCommunitySubscriptions CommunitySubscription[] @relation("ReviewedCommunitySubscriptions")
}

model CommunityMembership {
  id                       String          @id @default(auto()) @map("_id") @db.ObjectId
  role                     RoleInCommunity @default(MEMBER)
  assignedAt               DateTime        @default(now())

  user                     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                   String          @db.ObjectId

  community                Community       @relation(fields: [communityId], references: [id], onDelete: Cascade)
  communityId              String          @db.ObjectId

  canPublishPremiumContent Boolean         @default(false)

  @@unique([userId, communityId])
  @@index([communityId])
  @@index([userId])
}

model Community {
  id                     String   @id @default(auto()) @map("_id") @db.ObjectId
  name                   String   @unique
  description            String?
  createdAt              DateTime @default(now())
  esPublica              Boolean  @default(true)

  categoria              String?

  idiomaPrincipal        String?
  idiomaSecundario       String?

  logoUrl                String?
  logoPublicId           String?
  bannerUrl              String?
  bannerPublicId         String?

  createdBy              User     @relation("CreatedCommunities", fields: [createdById], references: [id])
  createdById            String   @db.ObjectId

  memberships            CommunityMembership[]
  posts                  Post[] @relation("CommunityPosts")
  subscriptionPlans      SubscriptionPlan[]
  communitySubscriptions CommunitySubscription[]
}

model Post {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  content       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  esPremium     Boolean  @default(false)
  isPinned      Boolean  @default(false)
  imageUrl      String?
  imagePublicId String?

  author        User      @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  authorId      String    @db.ObjectId

  community     Community @relation("CommunityPosts", fields: [communityId], references: [id], onDelete: Cascade)
  communityId   String    @db.ObjectId

  comments      Comment[] @relation("PostComments")
  reactions     Reaction[]

  @@index([communityId, createdAt])
  @@index([authorId])
}

model Comment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author    User     @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String   @db.ObjectId

  post      Post     @relation("PostComments", fields: [postId], references: [id], onDelete: Cascade)
  postId    String   @db.ObjectId

  @@index([postId, createdAt])
}

model Reaction {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  type      ReactionType
  createdAt DateTime     @default(now())

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String       @db.ObjectId

  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String       @db.ObjectId

  @@unique([userId, postId])
  @@index([postId])
  @@index([userId])
}

model Notification {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  createdAt   DateTime         @default(now())
  isRead      Boolean          @default(false)

  type        NotificationType

  recipient   User             @relation("Recipient", fields: [recipientId], references: [id], onDelete: Cascade)
  recipientId String           @db.ObjectId

  actor       User?            @relation("Actor", fields: [actorId], references: [id], onDelete: SetNull)
  actorId     String?          @db.ObjectId

  postId      String?          @db.ObjectId
  communityId String?          @db.ObjectId

  @@index([recipientId, createdAt])
}

model SubscriptionPlan {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  price       Float
  currency    String   @default("USD")
  interval    String   @default("month")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  community   Community @relation(fields: [communityId], references: [id])
  communityId String    @db.ObjectId

  communitySubscriptions CommunitySubscription[]
}

model CommunitySubscription {
  id               String                      @id @default(auto()) @map("_id") @db.ObjectId
  status           CommunitySubscriptionStatus @default(PENDING)

  paymentMethod    ManualPaymentMethod?
  paymentReference String?
  paymentProofUrl  String?

  userMessage      String?
  adminNote        String?

  requestedAt      DateTime                    @default(now())
  reviewedAt       DateTime?
  activatedAt      DateTime?
  rejectedAt       DateTime?
  canceledAt       DateTime?
  expiresAt        DateTime?
  updatedAt        DateTime                    @updatedAt

  subscriber       User                        @relation("UserCommunitySubscriptions", fields: [subscriberId], references: [id], onDelete: Cascade)
  subscriberId     String                      @db.ObjectId

  reviewedBy       User?                       @relation("ReviewedCommunitySubscriptions", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedById     String?                     @db.ObjectId

  community        Community                   @relation(fields: [communityId], references: [id], onDelete: Cascade)
  communityId      String                      @db.ObjectId

  plan             SubscriptionPlan?           @relation(fields: [planId], references: [id], onDelete: SetNull)
  planId           String?                     @db.ObjectId

  @@index([subscriberId])
  @@index([communityId])
  @@index([communityId, status])
  @@index([subscriberId, communityId, status])
  @@index([planId])
}